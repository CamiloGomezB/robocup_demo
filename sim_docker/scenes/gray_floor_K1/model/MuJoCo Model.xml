      <geom name="goal-left-top-net" size="0.3 1.3 0.05" pos="-0.3 0 1.8" type="box" rgba="1 1 1 0.2"/>
      <geom name="goal-left-back-net" size="0.05 1.3 0.9" pos="-0.6 0 0.9" type="box" rgba="1 1 1 0.2"/>
      <geom name="goal-left-left-side-net" size="0.3 0.05 0.9" pos="-0.3 -1.3 0.9" type="box" rgba="1 1 1 0.2"/>
      <geom name="goal-left-right-side-net" size="0.3 0.05 0.9" pos="-0.3 1.3 0.9" type="box" rgba="1 1 1 0.2"/>
    </body>
    <body name="goal-right" pos="7 0 0">
      <geom name="goal-right-front-left-post" size="0.05 0.9" pos="0 -1.3 0.9" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-front-right-post" size="0.05 0.9" pos="0 1.3 0.9" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-back-left-post" size="0.05 0.9" pos="0.6 -1.3 0.9" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-back-right-post" size="0.05 0.9" pos="0.6 1.3 0.9" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-front-left-corner" size="0.05 0.9" pos="0 -1.3 0.9" type="capsule" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-front-right-corner" size="0.05 0.9" pos="0 1.3 0.9" type="capsule" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-back-left-corner" size="0.05 0.9" pos="0.6 -1.3 0.9" type="capsule" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-back-right-corner" size="0.05 0.9" pos="0.6 1.3 0.9" type="capsule" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-front-crossbar" size="0.05 1.3" pos="0 0 1.8" quat="0 0 0.707107 0.707107" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-back-crossbar" size="0.05 1.3" pos="0.6 0 1.8" quat="0 0 0.707107 0.707107" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-left-side-crossbar" size="0.05 0.3" pos="0.3 -1.3 1.8" quat="0 0.707107 0 0.707107" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-right-side-crossbar" size="0.05 0.3" pos="0.3 1.3 1.8" quat="0 -0.707107 0 0.707107" type="cylinder" rgba="0.8 0.8 0.8 1"/>
      <geom name="goal-right-back-lower-crossbar" size="0.05 1.3" pos="0.6 0 0" quat="0 0 0.707107 0.707107" type="cylinder" rgba="0.8 0.8 0.8 1"/>
