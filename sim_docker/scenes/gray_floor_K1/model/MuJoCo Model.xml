      <geom name="goal-right-top-net" size="0.3 1.3 0.05" pos="0.3 0 1.8" type="box" rgba="1 1 1 0.2"/>
      <geom name="goal-right-back-net" size="0.05 1.3 0.9" pos="0.6 0 0.9" type="box" rgba="1 1 1 0.2"/>
      <geom name="goal-right-left-side-net" size="0.3 0.05 0.9" pos="0.3 -1.3 0.9" type="box" rgba="1 1 1 0.2"/>
      <geom name="goal-right-right-side-net" size="0.3 0.05 0.9" pos="0.3 1.3 0.9" type="box" rgba="1 1 1 0.2"/>
    </body>
    <body name="ball" pos="0 0 0.11">
      <joint name="ball-root" type="free"/>
      <geom name="ball" size="0.11" condim="6" priority="1" friction="0.4 0.01 0.01" solref="-5000 -20" mass="0.41" material="ball" rgba="1 1 1 1"/>
    </body>
    <frame name="__booster_robot_frame_robot1"/>
  </worldbody>
</mujoco>
